--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5a0011fd1a3bb7c4fb560a1f5e5870dc, type: 3}
  m_Name: Puerta
  m_EditorClassIdentifier: 
  texto: '{heroe} encontro una puerta sospechosa'
  opciones:
  - texto: TIrar abajo
    stat: 0
    dificultad: 5
    resultadoExito: "{heroe} destroz\xF3 la puerta, se encuentra oro del otro lado!"
    resultadoFallo: '{heroe} se lastima el dedito chico del pie al intentarlo...'
  - texto: Abrir lentamente
    stat: 1
    dificultad: 6
    resultadoExito: Al abrir lentamente, {heroe} descubre enemigos del otro lado!
      vuelve a cerrarla despacio y el grupo se aleja...
    resultadoFallo: Se escucho muy fuerte! {heroe} es lastimado por un goblin!
  - texto: Entrar sin pensar
    stat: 2
    dificultad: 8
    resultadoExito: '{heore} no se lo piensa dos veces... era una puerta normal'
    resultadoFallo: '{heroe} intenta pasar como si nada, era una puerta falsa, pintura
      en la pared... '
  - texto: Detectar que hay detras
    stat: 3
    dificultad: 7
    resultadoExito: '{heroe} no ve enemigos en la zona, y ve objetos!'
    resultadoFallo: '{heroe} es incapaz de hacerlo y se rinde, con miedo a abrirla'
